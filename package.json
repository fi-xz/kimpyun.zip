{
  "name": "kpj-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:font && pnpm run check:routes && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:font": "node scripts/check-font-coverage.mjs",
    "check:routes": "node scripts/wrangler-url-generator.mjs --check",
    "check:worker": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run check:worker",
    "font:subset": "node scripts/build-font-subset.mjs",
    "worker:routes": "node scripts/wrangler-url-generator.mjs",
    "deploy:pages": "pnpm run build && wrangler pages deploy ./dist --project-name=kpj-web --force",
    "deploy:worker": "pnpm run check:routes && wrangler deploy --config worker/wrangler.toml",
    "deploy": "pnpm run deploy:pages && pnpm run deploy:worker"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "wrangler": "^4.166.0"
  }
}
